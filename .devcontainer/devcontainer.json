{
    "name": "Loan Tool - Java 17 + MySQL",

    "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",

    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "17",
            "installMaven": true,
            "installGradle": false
        }
    },

    "forwardPorts": [
        3306
    ],

    "remoteEnv": {
        "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
    },

    "postCreateCommand": "bash .devcontainer/setup-mysql.sh",

    "postStartCommand": "bash .devcontainer/start-mysql.sh"
}