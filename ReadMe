
---Run this command to recoginzed mysql---

ps aux | grep '[m]ysqld'

sudo service mysql status

sudo chown mysql:mysql /var/run/mysqld

sudo mysqld_safe --user=mysql > /tmp/mysql-start.log 2>&1 &

sleep 5

ps aux | grep '[m]ysqld'

mysql -u root

--- dev start-mysql command ----
chmod +x .devcontainer/start-mysql.sh

